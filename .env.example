# ---------------------------------------------------------------
# SEO Hub — biến môi trường. Sao chép thành .env.local (không commit).
# ---------------------------------------------------------------

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL public của app (dùng cho link đăng nhập qua email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chỉ cho phép email thuộc domain công ty (tùy chọn), ví dụ: abc.com.vn
ALLOWED_EMAIL_DOMAIN=
# true = cho phép tự đăng ký bằng magic link; mặc định chỉ người đã được mời
ALLOW_SIGNUP=false

# Bright Data — dùng cho cả app và MCP server trong .mcp.json
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_SERP_ZONE=serp_api1
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1
# Scraper "LinkedIn people profiles - collect by URL" (mặc định gd_l1viktl72bvl7bjuj0)
# BRIGHTDATA_LINKEDIN_DATASET=

# Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
